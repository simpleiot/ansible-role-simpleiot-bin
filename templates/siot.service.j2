[Unit]
Description=Simple IoT server ({{ siot_binary }})
Documentation=https://simpleiot.org
After=network-online.target
Wants=network-online.target systemd-networkd-wait-online.service

[Service]
Restart=always
RestartSec=10

# SIOT_AUTH_TOKEN comes from here rather than an Environment= line, since the
# unit file is world readable and this file is not.
EnvironmentFile={{ siot_env_file }}

Environment=SIOT_DATA={{ siot_data_dir }}
{% if siot_http_port != "" %}
Environment=SIOT_HTTP_PORT={{ siot_http_port }}
{% endif %}

Environment=SIOT_NATS_PORT={{ siot_nats_port }}
{% if siot_nats_http_port != "" %}
Environment=SIOT_NATS_HTTP_PORT={{ siot_nats_http_port }}
{% endif %}
# below cannot be localhost because then certs fail
Environment=SIOT_NATS_SERVER={{ siot_nats_url }}
{% if siot_nats_ws_port != "" %}
Environment=SIOT_NATS_WS_PORT={{ siot_nats_ws_port }}
{% endif %}
{% if siot_nats_monitor_port != "" %}
Environment=SIOT_NATS_MONITOR_PORT={{ siot_nats_monitor_port }}
{% endif %}

{% if siot_user == "caddy2" %}
Environment=SIOT_NATS_TLS_CERT=/home/caddy2/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/{{ siot_domain }}/{{ siot_domain }}.crt
Environment=SIOT_NATS_TLS_KEY=/home/caddy2/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/{{ siot_domain }}/{{ siot_domain }}.key
Environment=SIOT_NATS_TLS_TIMEOUT={{ siot_nats_tls_timeout }}
{% endif %}
{% if siot_provisioning_src != "" %}
# Provisioning files are applied at start-up and again whenever one of them
# changes, so a configuration change needs no restart.
Environment=SIOT_PROVISIONING_DIR={{ siot_provisioning_dir }}
Environment=SIOT_PROVISIONING_INTERVAL={{ siot_provisioning_interval }}
{% endif %}
{% for name, value in siot_extra_env.items() %}
Environment={{ name }}={{ value }}
{% endfor %}

; User and group the process will run as.
User={{ siot_user }}
Group={{ siot_user }}

NoNewPrivileges=true
{% if siot_sandbox %}
# The service sees the rest of the system read-only and writes only the paths
# below, matching what `siot install` generates for a system service. A client
# that needs hardware (serial, GPIO, IIO, CAN) needs the device allowed in a
# drop-in; see `systemctl edit {{ siot_binary }}`.
ProtectSystem=strict
ProtectHome={{ siot_protect_home }}
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths={{ siot_read_write_paths | join(' ') }}
{% endif %}

ExecStart={{ siot_bin_dir }}/{{ siot_binary }}

[Install]
WantedBy=multi-user.target
